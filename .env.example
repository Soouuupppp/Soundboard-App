# Copy to .env and fill in. Used by docker-compose and the web app.

# --- Postgres ---
POSTGRES_USER=soundboard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=soundboard
# Hostname "db" is the docker-compose service name.
DATABASE_URL=postgres://soundboard:changeme@db:5432/soundboard

# --- Next.js / Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
# Public URL the browser sees. For local dev: http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Discord OAuth (https://discord.com/developers/applications) ---
# Add http://localhost:3000/api/auth/callback/discord as a redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs that are auto-promoted to the "admin" role on login.
DISCORD_ADMIN_IDS=

# --- Storage ---
# Path inside the web container where uploads land. The compose file binds ./data_public here.
UPLOADS_DIR=/data_public

# --- Default quotas (bytes). Per-user overrides and per-role values live in the DB. ---
DEFAULT_MAX_FILE_SIZE=5242880
DEFAULT_MAX_TOTAL_STORAGE=52428800
