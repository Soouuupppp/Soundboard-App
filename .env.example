# Copy to .env and fill in. Used by docker-compose and the web app.

# --- Postgres ---
POSTGRES_USER=soundboard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=soundboard
# Hostname "db" is the docker-compose service name.
DATABASE_URL=postgres://soundboard:changeme@db:5432/soundboard

# --- Next.js / Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
# Public URL the browser sees. For local dev: http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Public site URL used for SEO/OpenGraph metadata (app/layout.tsx). NOTE: this is a
# NEXT_PUBLIC_ var, so it's inlined at BUILD time — set it before `next build`
# (a build ARG / build-time env), not just at runtime. Defaults to a placeholder.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Discord OAuth (https://discord.com/developers/applications) ---
# Add http://localhost:3000/api/auth/callback/discord as a redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs that are auto-promoted to the "admin" role on login.
DISCORD_ADMIN_IDS=

# --- Storage ---
# Path inside the web container where uploads land. The compose file binds ./data_public here.
UPLOADS_DIR=/data_public

# --- Default quotas. Per-user overrides and per-role values live in the DB. ---
# File-size / total-storage are in BYTES.
DEFAULT_MAX_FILE_SIZE=5242880
DEFAULT_MAX_TOTAL_STORAGE=52428800
# ver/1.4.1: default number of profiles a user may create (user/role overrides in DB).
DEFAULT_PROFILE_LIMIT=5

# --- ver/1.4.1 Paid AI voice (all optional) ---
# The free rvc_zero engine needs NONE of these. These only enable the paid engines
# (ElevenLabs / Respeecher), gated by the admin "AI voice" master toggle. A user who
# pastes their own BYO key in the UI bypasses the app key + the quota below.
#
# Default monthly AI quota in SECONDS of converted audio (user/role overrides in DB).
DEFAULT_AI_QUOTA_SECONDS=300
# ElevenLabs — app-owned key (https://elevenlabs.io). When set, users spend it
# against the quota above; when unset, only BYO-key users can use ElevenLabs.
ELEVENLABS_API_KEY=
# Optional ElevenLabs overrides (sensible defaults are used when blank):
#   base   → https://api.elevenlabs.io/v1
#   STS    → eleven_english_sts_v2
#   TTS    → eleven_multilingual_v2
ELEVENLABS_API_BASE=
ELEVENLABS_STS_MODEL=
ELEVENLABS_TTS_MODEL=
# Respeecher — app-owned key + its account-specific endpoints. The STS/TTS URLs MUST
# be set for Respeecher to work (its REST surface varies per account); otherwise the
# proxy returns a clear "not configured" error. Continuous-live is not supported yet.
RESPEECHER_API_KEY=
RESPEECHER_STS_URL=
RESPEECHER_TTS_URL=

# --- YouTube import (yt-dlp) ---
# Path to the yt-dlp binary. The web image installs it on PATH, so leave unset
# unless yours lives elsewhere. Defaults to "yt-dlp".
# YTDLP_PATH=yt-dlp
# YouTube blocks datacenter/VPS IPs with "confirm you're not a bot". To get past
# it, export cookies from a logged-in (throwaway!) account as a Netscape
# cookies.txt and point this at the file on the host. Leave unset for local dev
# or IPs YouTube doesn't challenge. See README / docker-compose.yml.
# YTDLP_COOKIES_FILE=/home/soundboard/yt-cookies.txt
# On a datacenter/VPS IP, YouTube may still block even with cookies. Optional
# escape hatches: route through a proxy (residential is the reliable fix), and/or
# try an alternate player client. Leave unset unless you hit the bot wall.
# YTDLP_PROXY=http://user:pass@host:port        # or socks5://host:port
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default
