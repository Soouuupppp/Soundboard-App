{
  "name": "soundboard-electron",
  "productName": "Soundboard",
  "private": true,
  "version": "1.3.1",
  "description": "Desktop wrapper for the Soundboard web app with OS-level global hotkeys.",
  "author": {
    "name": "Soouuupppp",
    "email": "soouuuppppgames@gmail.com",
    "url": "https://soouuupppp.com"
  },
  "homepage": "https://soundboard.soouuupppp.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soouuupppp/Soundboard-App.git",
    "directory": "electron"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "soundboardUrl": "https://soundboard.soouuupppp.com",
  "scripts": {
    "start": "electron .",
    "bake": "node scripts/bake-url.js",
    "build:native": "node scripts/build-native.js",
    "dist": "pnpm bake && pnpm build:native && electron-builder",
    "dist:win": "pnpm bake && pnpm build:native && electron-builder --win",
    "dist:portable": "pnpm bake && pnpm build:native && electron-builder --win portable",
    "release:win": "pnpm bake && pnpm build:native && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.soouuupppp.soundboard",
    "productName": "Soundboard",
    "copyright": "Copyright © Soouuupppp",
    "npmRebuild": false,
    "files": [
      "main.js",
      "hotkeys.js",
      "vr-controllers.js",
      "preload.js",
      "prompt-preload.js",
      "package.json",
      "baked.json",
      "assets/**"
    ],
    "extraResources": [
      { "from": "resources/vr", "to": "vr", "filter": ["**/*"] }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Soundboard",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Soouuupppp",
        "repo": "Soundboard-App",
        "releaseType": "draft"
      }
    ]
  }
}
