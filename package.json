{
  "name": "soundboard-monorepo",
  "private": true,
  "version": "1.4.0",
  "description": "Discord-authenticated soundboard with web dashboard, public sharing, a virtual-mic mixer, and an Electron wrapper for OS-level global hotkeys.",
  "author": {
    "name": "Soouuupppp",
    "email": "soouuuppppgames@gmail.com",
    "url": "https://soouuupppp.com"
  },
  "homepage": "https://soouuupppp.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soouuupppp/soundboard_website.git"
  },
  "bugs": {
    "url": "https://github.com/Soouuupppp/soundboard_website/issues"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/docker-rebuild.mjs --detach",
    "dev:web": "pnpm --filter soundboard-web dev",
    "build": "pnpm --filter soundboard-web build",
    "db:migrate": "pnpm --filter soundboard-web db:migrate",
    "electron": "pnpm --filter soundboard-electron start",
    "up": "node scripts/docker-rebuild.mjs",
    "deploy": "node scripts/docker-rebuild.mjs --env-file /home/soundboard/.env --detach",
    "rollback": "node scripts/docker-rollback.mjs --env-file /home/soundboard/.env --detach",
    "down": "docker compose down"
  },
  "packageManager": "pnpm@9.12.3"
}
